generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                  String    @id @default(cuid())
  clerkId             String    @unique
  level               Int       @default(1)
  totalXP             Int       @default(0)
  currentStreak       Int       @default(0)
  multiplier          Float     @default(1.0)
  googleCalendarToken String?
  /// Lifetime Spin the Wheel uses — drives Chaos Agent achievement.
  spinCount           Int       @default(0)
  /// User-tunable scheduler overrides (weights, working hours, break policy, etc.).
  /// Shape: Partial<UserConfig> — see server/src/lib/userConfig.ts.
  schedulerSettings   Json?
  /// User-editable tracker presets (active cap, status labels, code prefixes,
  /// required fields, review cadence). Shape: Partial<TrackerConfig> —
  /// see server/src/lib/trackerConfig.ts. Domains are rows, not config.
  trackerSettings     Json?

  quests         Quest[]
  checkIns       DailyCheckIn[]
  xpEvents       XPEvent[]
  achievements   UserAchievement[]
  scheduleBlocks ScheduleBlock[]
  recurringCompletions RecurringCompletion[]
  trackerItems   TrackerItem[]
  trackerDomains TrackerDomain[]
  parkingLot     ParkingLotEntry[]
  decisions      DecisionLogEntry[]
  casInterviews  CasInterview[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

model Quest {
  id               String    @id @default(cuid())
  userId           String
  title            String
  estimatedMinutes Int       @default(30)
  mentalLoad       Int       @default(5)
  impact           Int       @default(5)
  deadline         DateTime?
  status           QuestStatus @default(ACTIVE)
  parentQuestId    String?
  tags             String[]

  // ── Scheduler hints (all optional; defaults applied at adapter layer) ──
  /// 0..1 — how boring/draining the user finds this; drives adjacency penalty
  tediousness     Float?
  /// One of: deep_work | comms | admin | creative — drives context-switch penalty
  category        String?
  /// 0..23 — preferred hour of day; gaussian fit with σ=2
  preferredHour   Int?
  /// Hard minimum chunk minutes
  minChunkMin     Int?
  /// Hard maximum chunk minutes (also obeyed by softMaxBlockMin)
  maxChunkMin     Int?
  /// 0..1 — setup cost (long-warmup tasks prefer longer chunks)
  setupCost       Float?
  /// Multiplier on the urgency sub-score; 1.0 = default. >1 boosts, <1 dampens.
  urgencyMult     Float?    @default(1.0)
  /// True = recurring daily quest; placed as a fixed block; never goes COMPLETE.
  isRecurring     Boolean   @default(false)
  /// User-set priority tier — HIGH/MED/LOW. HIGH boosts importance and urgency;
  /// LOW dampens both and is excluded in "crush" planning mode.
  priorityTier    PriorityTier @default(MED)

  user          User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  parentQuest   Quest?  @relation("SubQuests", fields: [parentQuestId], references: [id])
  subQuests     Quest[] @relation("SubQuests")
  xpEvents      XPEvent[]
  scheduleBlocks ScheduleBlock[]
  recurringCompletions RecurringCompletion[]

  actualMinutes Int?
  completedAt   DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("quests")
}

model RecurringCompletion {
  id        String   @id @default(cuid())
  questId   String
  userId    String
  date      DateTime @db.Date
  xpAwarded Int

  quest Quest @relation(fields: [questId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([questId, date])
  @@index([userId, date])
  @@map("recurring_completions")
}

enum QuestStatus {
  ACTIVE
  COMPLETE
  NOT_TODAY
  RESCUE
}

enum PriorityTier {
  HIGH
  MED
  LOW
}

model DailyCheckIn {
  id               String   @id @default(cuid())
  userId           String
  date             DateTime @db.Date
  energyLevel      Int
  availableMinutes Int

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([userId, date])
  @@map("daily_check_ins")
}

model XPEvent {
  id        String   @id @default(cuid())
  userId    String
  questId   String?
  amount    Int
  reason    String

  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  quest Quest? @relation(fields: [questId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@map("xp_events")
}

model Achievement {
  id          String @id @default(cuid())
  slug        String @unique
  title       String
  description String
  icon        String
  xpReward    Int

  userAchievements UserAchievement[]

  @@map("achievements")
}

model UserAchievement {
  id            String   @id @default(cuid())
  userId        String
  achievementId String
  unlockedAt    DateTime @default(now())

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  achievement Achievement @relation(fields: [achievementId], references: [id], onDelete: Cascade)

  @@unique([userId, achievementId])
  @@map("user_achievements")
}

model ScheduleBlock {
  id           String        @id @default(cuid())
  userId       String
  questId      String?
  startTime    DateTime
  endTime      DateTime
  durationMins Int
  reason       String
  blockType    BlockType
  isFlexible   Boolean       @default(true)
  date         DateTime      @db.Date
  /// User pinned this block; planner must respect on replan. Mirrors in-memory Block.locked.
  locked       Boolean       @default(false)
  /// Score-breakdown summary stored at generation time. Mirrors in-memory Block.note.
  note         String?

  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  quest Quest? @relation(fields: [questId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, date])
  @@map("schedule_blocks")
}

enum BlockType {
  FOCUS
  BUFFER
  DEADLINE_ANCHOR
  CALENDAR
  WORK
  BREAK
  FIXED
}

// ─── Long-horizon tracker ─────────────────────────────────────────────────────
// Two-year, ~100+ item horizon. Deliberately flat: no subtasks, no priority
// levels (the scheduler owns weighting). Items feed the scheduler by having
// their `nextAction` materialised as a Quest — see questId below.

model TrackerDomain {
  id     String @id @default(cuid())
  userId String
  name   String
  /// Hex colour for chips/sections, e.g. "#8b5cf6".
  color  String @default("#8b5cf6")
  /// Manual sort position; lower sorts first.
  sortOrder Int  @default(0)

  user  User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  items TrackerItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, name])
  @@index([userId, sortOrder])
  @@map("tracker_domains")
}

model TrackerItem {
  id       String        @id @default(cuid())
  userId   String
  /// Stable human-facing code, e.g. "A29". Unique per user; never reused.
  /// Import matches on this, so it must not change once assigned.
  code     String
  domainId String?
  title    String
  status   TrackerStatus @default(TODO)
  /// Physical first step, not a topic. Required for ACTIVE (configurable).
  nextAction String?
  notes      String?
  dueDate    DateTime?

  /// Optional link to the Quest materialised from `nextAction`, so the
  /// existing scheduler consumes tracker work instead of re-planning it.
  questId  String?

  // ── CAS fields (a lens over the same items; empty = not a CAS item) ──
  /// Subset of: creativity | activity | service. Non-empty ⇒ CAS-tagged.
  casStrands        String[]
  /// IB learning outcomes evidenced by this item, values 1..7.
  learningOutcomes  Int[]
  /// CAS may not double-count with DP coursework — flagged for resolution.
  isCourseworkLinked Boolean  @default(false)
  casStartDate       DateTime?
  casEndDate         DateTime?
  isCasProject       Boolean  @default(false)
  /// Only surfaced when the optional hours toggle is on; IB requires no hours.
  hours              Float?

  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  domain      TrackerDomain? @relation(fields: [domainId], references: [id], onDelete: SetNull)
  reflections Reflection[]

  completedAt DateTime?
  droppedAt   DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([userId, code])
  @@index([userId, status])
  @@index([userId, domainId])
  @@map("tracker_items")
}

enum TrackerStatus {
  TODO
  ACTIVE
  BLOCKED
  DONE
  DROPPED
}

model Reflection {
  id     String   @id @default(cuid())
  itemId String
  text   String
  date   DateTime @default(now())
  /// Learning outcomes this reflection evidences, values 1..7.
  loTags Int[]
  /// Optional media pointer (URL or object key); no upload pipeline yet.
  mediaUrl String?

  item TrackerItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([itemId, date])
  @@map("reflections")
}

model ParkingLotEntry {
  id     String  @id @default(cuid())
  userId String
  /// Zero-friction capture — text is the only required field.
  text   String
  /// Set when the entry graduates into a real item.
  promotedToCode String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@map("parking_lot_entries")
}

model DecisionLogEntry {
  id     String   @id @default(cuid())
  userId String
  text   String
  /// Append-only by convention: no update/delete routes are exposed.
  decidedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([userId, decidedAt])
  @@map("decision_log_entries")
}

model CasInterview {
  id     String @id @default(cuid())
  userId String
  /// Which of the three required coordinator interviews: 1, 2 or 3.
  ordinal Int
  date    DateTime?
  notes   String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, ordinal])
  @@map("cas_interviews")
}
