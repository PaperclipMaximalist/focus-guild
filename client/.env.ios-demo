# Read by `npm run build:demo` (vite --mode ios-demo): the demo build of the app.
# It answers the API from design/lines/fixtures/*.json, signed in as the sample
# member, and is steered by /demo-route.json (src/demo/). Used on CI to
# photograph every screen on the iPhone simulator.
VITE_DEMO=1

# A host that can never answer: if a request ever escaped the sample data it
# would fail loudly instead of reaching the live service.
VITE_API_URL=https://demo.invalid
VITE_WEB_URL=https://demo.invalid

# The app never loads Clerk.
VITE_CLERK_PUBLISHABLE_KEY=
