# Baked into the iOS app by `npm run build:ios` (vite --mode ios).
# Nothing here is secret: these are the public addresses of the live service.

# The API the app talks to.
VITE_API_URL=https://focus-guild-production.up.railway.app

# The website. The app opens <VITE_WEB_URL>/app-link in a browser sheet to sign in.
VITE_WEB_URL=https://focus-guild-ten.vercel.app

# The app never loads Clerk (sign-in happens on the website), so no key is baked in.
VITE_CLERK_PUBLISHABLE_KEY=
