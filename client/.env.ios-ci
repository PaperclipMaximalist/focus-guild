# For the iOS sign-in CI job only (.github/workflows/ios-signin.yml, through
# `npm run build:ios:ci`, vite --mode ios-ci). Never for a build anyone installs.
# The simulator shares the Mac runner's network, so 127.0.0.1 inside the app is
# the runner, where that job starts a throwaway API and the website.
# Plain HTTP: the job (not the repository) allows local networking in Info.plist.

VITE_API_URL=http://127.0.0.1:3000
VITE_WEB_URL=http://127.0.0.1:5173

# The app never loads Clerk; the website on the runner runs in dev auth too.
VITE_CLERK_PUBLISHABLE_KEY=
